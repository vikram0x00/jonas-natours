extends base

//- block append head 
	//- script(src="/script.js" defer)

block content
	#notification.notification.hidden
		i.bi.bi-info-circle
		span This is a test notification
	section.banner(style=`background-image: url(/img/${tour.imageCover})`)
		h1= tour.name
		p
			span
				i.bi.bi-geo-alt
				| #{tour.startLocation.description}
			span
				i.bi.bi-clock
				| #{tour.duration} days
	section.info
		.about
			h3 About this Tour
			p
				| #{tour.description}
		.tour-info
			h3 Tour Info
			span
				i.bi.bi-geo-alt
				|	#{tour.startLocation.description}
			span
				i.bi.bi-calendar
				| #{tour.startDates[0].toLocaleString("en-in", { month: "long", year: "numeric" })}
			span
				i.bi.bi-flag
				| #{tour.locations.length} stops
			span
				i.bi.bi-person
				| #{tour.maxGroupSize} people
			span
				i.bi.bi-tag-fill
				| $#{tour.price}
			span
				i.bi.bi-star-fill
				| #{tour.ratingsAverage} (#{tour.ratingsQuantity} ratings)
		.guides
			h3 Tour Guides
			each guide in tour.guides 
				.guide-item
					img(src=`/img/${guide.photo}`)
					span= guide.name
	section.images
		each image in tour.images
			img(src=`/img/${image}` alt=`${image}`)
	section.map
		h1 Tour Map
		section.map-container(id="map" data-locations=`${JSON.stringify(tour.locations)}`)
	section.reviews
		h1 Reviews
		.reviews-container
			each review in tour.reviews 
				.review-item
					div
						img(src=`/img/${review.user.photo}` alt='User')
						span= review.user.name
					p= review.review
					span
						i.bi.bi-star-fill
						| #{review.rating}
	section.book
		h2 What are you waiting for? Book the Tour Now!
		if user
			button.button-lg(id="bookTour" data-tourId=`${tour.id}`) BOOK NOW
		else 
			a.button-lg(href='/login') LOG IN

	script(src="https://cdn.maptiler.com/maptiler-sdk-js/v4.0.1/maptiler-sdk.umd.min.js")
	script(src="/script.js")
	script(src="/logout.js")
	script(src="/stripe.js")